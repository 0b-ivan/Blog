# Fine-grained GitHub token for 0b-ivan/Blog.
# Required repository permissions:
# - Contents: Read and write
# - Pull requests: Read and write
OBSIDIAN_PUBLISHER_GITHUB_TOKEN=replace-with-fine-grained-token

PUBLISHER_GITHUB_REPOSITORY=0b-ivan/Blog
PUBLISHER_BASE_BRANCH=main

# Article content must stay unchanged for this many seconds before a PR is created/updated.
PUBLISHER_DEBOUNCE_SECONDS=300

# How often the local LiveSync mirror is checked.
PUBLISHER_POLL_SECONDS=30
