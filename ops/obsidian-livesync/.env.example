# CouchDB credentials used by Self-hosted LiveSync.
# Use a long random password in the real .env file.
COUCHDB_USER=obsidian
COUCHDB_PASSWORD=replace-with-a-long-random-password
COUCHDB_DATABASE=kernelnotes

# Optional: only needed when this stack should run its own cloudflared container.
# Leave empty when an existing Cloudflare Tunnel is already in use.
CF_TUNNEL_TOKEN=
