# CouchDB credentials used by Self-hosted LiveSync.
# Use a long random password in the real .env file.
COUCHDB_USER=obsidian
COUCHDB_PASSWORD=replace-with-a-long-random-password
COUCHDB_DATABASE=kernelnotes

# Optional path used by the headless LiveSync CLI.
# Relative paths are resolved from ops/obsidian-livesync.
# The default ../../posts points at the repository's posts/ directory.
OBSIDIAN_VAULT_PATH=../../posts

# Article images are exposed inside the Vault as assets/posts/ so Obsidian
# can resolve root-relative Markdown image paths such as /assets/posts/foo/bar.jpg.
OBSIDIAN_ASSETS_PATH=../../assets/posts

# Optional: only needed when this stack should run its own cloudflared container.
# Leave empty when an existing Cloudflare Tunnel is already in use.
CF_TUNNEL_TOKEN=
