{
  "name": "kernel-notes-blog",
  "version": "1.0.0",
  "private": true,
  "description": "Static IT blog served via Node and containerized with Docker Compose",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "posts:sync-meta": "node scripts/sync-post-metadata.js",
    "posts:validate-meta": "node scripts/validate-post-frontmatter.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-footnote": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.9.1",
    "supertest": "^7.0.0",
    "vitest": "^4.1.11"
  }
}
