FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV TEXMFVAR=/var/cache/texmf
ENV TEXMFCACHE=/var/cache/texmf

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    pandoc \
    texlive-luatex \
    texlive-latex-base \
    texlive-latex-recommended \
    texlive-latex-extra \
    texlive-fonts-recommended \
    texlive-lang-german \
    texlive-lang-japanese \
    texlive-pictures \
    librsvg2-bin \
    fonts-texgyre \
    fonts-noto-cjk \
    lmodern \
  && rm -rf /var/lib/apt/lists/*

# LuaLaTeX otherwise builds its font database on the first PDF request.
# The renderer runs as the unprivileged "node" user, so the cache must be built
# in a shared TEXMFVAR/TEXMFCACHE path owned by that same runtime user.
RUN mkdir -p /var/cache/texmf \
  && chown -R node:node /var/cache/texmf \
  && su -s /bin/sh node -c 'luaotfload-tool --update --force'

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci --omit=dev --no-audit --no-fund \
  && npm cache clean --force

COPY lib ./lib
COPY config ./config
COPY templates ./templates
COPY assets ./assets
COPY posts ./posts
COPY snippets ./snippets
COPY server.js pdf-export-server.js ./

ENV PORT=8092
ENV POSTS_DIR=/app/posts
ENV PDF_LATEX_TEMPLATE=/app/templates/paper.tex
ENV PDF_COMPILE_TIMEOUT_MS=120000

USER node

EXPOSE 8092

CMD ["node", "pdf-export-server.js"]
