FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    pandoc \
    texlive-luatex \
    texlive-latex-base \
    texlive-latex-recommended \
    texlive-latex-extra \
    texlive-fonts-recommended \
    texlive-lang-german \
    texlive-pictures \
    fonts-texgyre \
    lmodern \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci --omit=dev --no-audit --no-fund \
  && npm cache clean --force

COPY lib ./lib
COPY config ./config
COPY templates ./templates
COPY assets ./assets
COPY posts ./posts
COPY snippets ./snippets
COPY server.js pdf-export-server.js ./

ENV PORT=8092
ENV POSTS_DIR=/app/posts
ENV PDF_LATEX_TEMPLATE=/app/templates/paper.tex
ENV PDF_COMPILE_TIMEOUT_MS=60000

USER node

EXPOSE 8092

CMD ["node", "pdf-export-server.js"]
